{
  "name": "piotrbaczek/chess-engine",
  "description": "Example PHP project",
  "type": "project",
  "require": {
    "php": "^8.5",
    "ext-bcmath": "*",
    "phpseclib/phpseclib": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "piotrbaczek\\ChessEngine\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "scripts": {
    "test": "phpunit ./tests/"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
