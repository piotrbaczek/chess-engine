{
  "name": "piotrbaczek/chess-engine",
  "description": "Example PHP project",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.5",
    "ext-ctype": "*",
    "ext-gmp": "*",
    "phpseclib/phpseclib": "^4.0.1",
    "ramsey/collection": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "piotrbaczek\\ChessEngine\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3",
    "ext-xdebug": "*"
  },
  "scripts": {
    "test": "phpunit ./tests/ --testdox --display-errors --display-warnings --colors=always",
    "test-pipeline": "phpunit ./tests/ --testdox --display-errors --display-warnings --display-deprecations --colors=always --coverage-text"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
